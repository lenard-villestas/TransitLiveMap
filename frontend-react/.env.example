# Frontend build-time configuration (Vite). Copy to `.env` and fill in as needed.
# `.env` is gitignored; this example is committed as documentation. Vite only exposes
# variables prefixed with VITE_ to the client bundle.

# Optional MapTiler API key (https://www.maptiler.com/). With a key the app uses
# MapTiler's `dataviz` (Positron-like) basemap; left blank it falls back to the
# keyless OpenFreeMap basemap so it still runs out of the box.
VITE_MAPTILER_KEY=

# Backend API base URL. Leave BLANK for a single-origin deployment (uvicorn serves both
# this bundle and /api/*) or for local dev (the Vite dev server proxies /api → :8000).
# Set it to your backend's origin when hosting the frontend separately (e.g. on a CDN),
# with no trailing slash, e.g.:
#   VITE_API_BASE=https://your-backend.onrender.com
VITE_API_BASE=
